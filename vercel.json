{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "buildCommand": "ng build",
    "outputDirectory": "dist/increo-landing/browser",
    "framework": "angular",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/$1"
        },
        {
            "source": "/((?!api/).*)",
            "destination": "/index.html"
        }
    ]
}